{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@plot/agent": ["packages/agent/src/index.ts"],
      "@plot/cli": ["packages/cli/src/index.ts"],
      "@plot/contracts": ["packages/contracts/src/index.ts"],
      "@plot/core": ["packages/core/src/index.ts"],
      "@plot/sdk": ["packages/sdk/src/index.ts"],
      "@plot/server": ["packages/server/src/index.ts"],
      "@plot/tracker": ["packages/tracker/src/index.ts"],
      "@plot/tui": ["packages/tui/src/index.ts"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "composite": true
  }
}
