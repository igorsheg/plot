{
	"name": "@plot/plot",
	"version": "0.0.1",
	"private": true,
	"description": "orchestrate coding agents against an issue tracker",
	"keywords": [
		"agents",
		"ai",
		"cli",
		"github",
		"orchestrator"
	],
	"homepage": "https://github.com/igorsheg/plot",
	"bugs": {
		"url": "https://github.com/igorsheg/plot/issues"
	},
	"license": "MIT",
	"author": "Igor Sheg <igorsheg@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/igorsheg/plot.git",
		"directory": "packages/plot"
	},
	"bin": {
		"plot-ai": "./src/cli/index.ts"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun run --watch src/main.ts",
		"typecheck": "tsc -b tsconfig.json",
		"lint": "oxlint src --tsconfig ../../tsconfig.json",
		"test": "bun test src"
	},
	"dependencies": {
		"@effect/platform-bun": "catalog:",
		"@mariozechner/pi-ai": "^0.57.1",
		"@mariozechner/pi-coding-agent": "^0.57.1",
		"@plot/sdk": "workspace:*",
		"@plot/tui": "workspace:*",
		"effect": "catalog:",
		"eta": "^4.5.1",
		"gray-matter": "^4.0.3",
		"yaml": "^2.8.2"
	},
	"devDependencies": {
		"@mariozechner/pi-agent-core": "^0.57.1",
		"bun-types": "catalog:"
	},
	"engines": {
		"node": ">=18"
	}
