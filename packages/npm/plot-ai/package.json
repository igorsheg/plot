{
	"name": "plot-ai",
	"version": "0.0.0",
	"private": true,
	"description": "Workflow agent runtime and CLI",
	"keywords": [
		"agents",
		"ai",
		"automation",
		"cli"
	],
	"homepage": "https://github.com/igorsheg/plot",
	"bugs": {
		"url": "https://github.com/igorsheg/plot/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/igorsheg/plot.git"
	},
	"bin": {
		"plot": "bin/plot"
	},
	"files": [
		"bin",
		"docs",
		"examples",
		"lib",
		"postinstall.mjs",
		"README.md"
	],
	"type": "module",
	"exports": {
