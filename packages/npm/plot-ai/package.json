			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		},
		"./sdk": {
			"types": "./lib/sdk.d.ts",
			"import": "./lib/sdk.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"postinstall": "node ./postinstall.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.80.6",
		"@earendil-works/pi-coding-agent": "0.80.6"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
