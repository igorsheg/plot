{
	"name": "@plot/sdk",
	"version": "0.0.1",
	"description": "plugin SDK for plot-ai tracker integrations",
	"author": "Igor Sheg <igorsheg@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/igorsheg/plot.git",
		"directory": "packages/sdk"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugin/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"typecheck": "tsc -b tsconfig.json",
		"lint": "oxlint src --tsconfig ../../tsconfig.json"
	},
	"peerDependencies": {
		"effect": ">=4.0.0-beta.0"
	},
	"peerDependenciesMeta": {
		"effect": {
			"optional": true
		}
	},
	"devDependencies": {
		"bun-types": "catalog:",
		"effect": "catalog:"
	}
}
