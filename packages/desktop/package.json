{
	"name": "@plot/desktop",
	"private": true,
	"scripts": {
		"start": "bun run build:views && electrobun build && electrobun dev",
		"build": "bun run build:views && electrobun build",
		"typecheck": "tsc -b tsconfig.json",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bunx vite --port 5174\" \"bun run start\"",
		"build:views": "bunx vite build"
	},
	"dependencies": {
		"@milkdown/crepe": "^7.19.2",
		"@milkdown/ctx": "^7.19.2",
		"@milkdown/kit": "^7.19.2",
		"@milkdown/react": "^7.19.2",
		"electrobun": "latest",
		"gray-matter": "^4.0.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"yaml": "^2.8.3",
		"@plot/ui": "workspace:*",
		"@base-ui/react": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.5.0",
		"lucide-react": "^0.577.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"typescript": "^5.8.2",
		"@tailwindcss/vite": "^4.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"tailwindcss": "^4.0.0",
		"vite": "^6.0.3",
		"concurrently": "^9.1.0"
	}
