		"lucide-react": "^0.577.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.5.0",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.0.0",
		"@types/bun": "latest",
		"@types/react": "^19.1.0",
