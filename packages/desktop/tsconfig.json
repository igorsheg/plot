{
	"compilerOptions": {
		"plugins": [{ "name": "@effect/language-service" }],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@plot/ui/components/*": ["../ui/src/components/*"],
			"@plot/ui/lib/*": ["../ui/src/lib/*"]
		}
	},
	"include": ["src"],
	"references": [
		{ "path": "../ui" },
		{ "path": "../sdk" }
	]
}
