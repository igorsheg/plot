{
	"extends": "@repo/tsconfig/base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"noEmit": true,
		"types": ["bun-types", "vite/client"],
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
}
