{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"noEmit": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@plot/ui/components/*": [
				"../ui/src/components/*"
			],
			"@plot/ui/lib/*": [
				"../ui/src/lib/*"
			]
		}
	},
	"include": [
		"src"
	],
	"references": [
		{
			"path": "../sdk"
		},
		{
			"path": "../ui"
		}
	]
}
