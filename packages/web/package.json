{
	"name": "@plot/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others --names api,vite \"bun run dev:api\" \"bun run dev:vite\"",
		"dev:api": "bun ../cli/src/main.ts serve api --http --host 127.0.0.1 --port 4317 --cwd ../..",
		"dev:vite": "vite --host 127.0.0.1",
		"build": "vite build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "oxlint src test --tsconfig tsconfig.json",
		"test": "bun test test",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource/barlow": "^5.2.8",
		"@nanostores/query": "^0.3.4",
		"@nanostores/react": "^1.1.0",
		"@phosphor-icons/react": "^2.1.10",
		"@plot/common": "workspace:*",
		"@plot/projection": "workspace:*",
		"@plot/sdk": "workspace:*",
		"@plot/session": "workspace:*",
		"@plot/session-manager": "workspace:*",
		"@tailwindcss/vite": "^4.3.1",
		"@vitejs/plugin-react": "latest",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cva": "^1.0.0-beta.4",
		"motion": "^12.42.2",
		"nanostores": "^1.4.0",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.1",
		"vite": "npm:rolldown-vite@latest"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@storybook/react-vite": "^10.4.6",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^10.0.3",
		"storybook": "^10.4.6",
		"typescript": "^7.0.2"
	}
}
