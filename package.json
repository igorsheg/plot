{
	"name": "@igorsheg/plot",
	"private": true,
	"packageManager": "bun@1.3.5",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"lint": "turbo run lint",
		"lint:fix": "oxlint --tsconfig tsconfig.json --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"typecheck": "turbo run typecheck",
		"check": "bun run typecheck && bun run lint && bun run fmt:check",
		"test": "turbo run test",
		"dev": "turbo run dev --filter=@plot/plot --filter=@plot/web --parallel",
		"dev:server": "turbo run dev --filter=@plot/plot",
		"dev:web": "turbo run dev --filter=@plot/web",
		"build": "turbo run build",
		"build:web": "turbo run build --filter=@plot/web",
		"plot": "bun run packages/plot/src/cli/index.ts",
		"ui:add": "bunx shadcn@latest add --cwd packages/web --yes",
		"clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
		"release:build": "bun run scripts/release/build.ts",
		"release:publish": "bun run scripts/release/publish.ts",
		"release:publish:dry-run": "bun run scripts/release/publish.ts --dry-run",
		"release:smoke": "bun run scripts/release/smoke.ts"
	},
	"devDependencies": {
		"oxfmt": "latest",
		"oxlint": "latest",
		"turbo": "^2.8.13",
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"@opentui/core": "^0.1.86"
	}
}
