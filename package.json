{
	"name": "plot",
	"private": true,
	"description": "LLM that ticks()",
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"bootstrap": "bun install",
		"typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
		"lint": "oxlint github-pr-reviewer.extension.ts github-pr-review-poster.ts --tsconfig tsconfig.json && turbo run lint",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"test": "turbo run test",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
	},
	"devDependencies": {
		"bun-types": "^1.3.10",
		"oxfmt": "^0.54.0",
		"oxlint": "^1.69.0",
		"turbo": "^2.9.16",
		"typescript": "^5.8.2"
	},
	"packageManager": "bun@1.3.5"
}
