{
	"name": "plot",
	"private": true,
	"description": "Plot agent control-plane runtime and CLI",
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"bootstrap": "bun install",
		"prepare": "lefthook install",
		"typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
		"lint": "oxlint examples/pr-review examples/debug --tsconfig tsconfig.json && turbo run lint",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"test": "bun test examples/pr-review/*.test.ts && turbo run test",
		"check:docs": "bun run scripts/check-docs-snippets.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run check:docs && bun run test",
		"release:build": "bun run scripts/release/build.ts",
		"release:smoke": "bun run scripts/release/smoke.ts",
		"release:publish": "bun run scripts/release/publish.ts",
		"release:publish:dry-run": "bun run scripts/release/publish.ts --dry-run",
		"release:local": "bun run scripts/release/local.ts"
	},
	"devDependencies": {
		"bun-types": "^1.3.10",
		"lefthook": "^2.1.9",
		"oxfmt": "^0.54.0",
		"oxlint": "^1.69.0",
		"turbo": "^2.9.16",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.5"
}
