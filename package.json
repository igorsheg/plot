{
  "name": "plot",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint --tsconfig tsconfig.json",
    "lint:fix": "oxlint --tsconfig tsconfig.json --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "check": "bun run typecheck && bun run lint && bun run fmt:check",
    "test": "bun test",
    "dev:server": "bun run --watch packages/server/src/main.ts",
    "dev:web": "bun run --filter @plot/web dev",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.8.2"
  }
}
