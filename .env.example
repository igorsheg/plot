# server port (default: 3000)
# PLOT_PORT=3000

# workflow file path (default: ./WORKFLOW.md)
# PLOT_WORKFLOW=./WORKFLOW.md

# tracker kind: local-fs or github
# PLOT_TRACKER_KIND=local-fs

# local issues directory (used when PLOT_TRACKER_KIND=local-fs)
# PLOT_ISSUES_DIR=./issues

# github repository in owner/repo form (used when PLOT_TRACKER_KIND=github)
# PLOT_GITHUB_REPO=owner/repo

# server logging
# PLOT_LOG_FORMAT=pretty
# PLOT_LOG_LEVEL=info

