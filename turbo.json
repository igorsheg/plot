{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../@repo/*.json"],
			"outputs": []
		},
		"lint": {
			"dependsOn": ["^lint"],
			"inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "../../.oxlintrc.json"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": []
		}
	}
}
